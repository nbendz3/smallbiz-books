modules = ["nodejs-22", "postgresql-16"]
run = ["sh", "-c", "npm install --no-audit --no-fund && npm run dev"]

[env]
PORT = "5000"
APP_TIMEZONE = "America/Los_Angeles"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install --no-audit --no-fund && npm run build"]
run = ["sh", "-c", "npm run start"]
